msgstr "Disparo de prueba: %.0f%% durante %d ms"

msgid "Tests and calibration"
msgstr "Pruebas y calibración"

msgid "Text"
msgstr "Texto"

msgid "Text around the bottom of the stamp, reading left to right (empty: none)"
msgstr ""
"Texto alrededor de la parte inferior del sello, de izquierda a derecha "
"(vacío: ninguno)"

msgid "Text around the top of the stamp, reading left to right"
msgstr "Texto alrededor de la parte superior del sello, de izquierda a derecha"

msgid "Text at the bottom"
msgstr "Texto abajo"

msgid "Text at the top"
msgstr "Texto arriba"

