msgstr "Grubość wypukłej ramki dookoła (0: bez ramki)"

msgid "Width of the raised outer ring (0: none)"
msgstr "Szerokość wypukłego pierścienia zewnętrznego (0: brak)"

msgid "Width of the ring inside the text (0: none)"
msgstr "Szerokość pierścienia wewnątrz tekstu (0: brak)"

msgid "Width of the ruler"
msgstr "Szerokość linijki"

msgid "Width of the stamp (own size)"
msgstr "Szerokość pieczątki (własny rozmiar)"

