msgstr "Najpierw zaznacz obrazek do wektoryzacji."

msgid "Select an opened file or a text with lines to break it apart."
msgstr "Zaznacz otwarty plik albo tekst z liniami, aby go rozbić."

msgid "Select and move"
msgstr "Zaznacz i przesuń"

msgid "Select every element on the bed"
msgstr "Zaznacz wszystkie elementy na stole"

