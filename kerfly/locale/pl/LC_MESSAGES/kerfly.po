#, python-format
msgid "%(name)s inserted: %(n)d shapes. Drag it into place; Undo takes it away."
msgstr ""
"%(name)s wstawiono: %(n)d kształtów. Przeciągnij na miejsce; Cofnij usuwa"
" całość."

#, python-format
msgid ""
"%(version)s on %(port)s. Laser mode is off ($32=0): the head stops at "
"every corner; switch it on with $32=1 in the machine's settings."
msgstr ""
"%(version)s na %(port)s. Tryb lasera jest wyłączony ($32=0): głowica "
"zatrzymuje się w każdym narożniku; włącz go ustawieniem $32=1 w maszynie."

